[Unit]
Description=Pulse 109 GovTech demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/pulse109
EnvironmentFile=%h/pulse109/.env
ExecStartPre=/usr/bin/mkdir -p %h/pulse109/data
ExecStart=%h/pulse109/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8025 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
UMask=0077
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
