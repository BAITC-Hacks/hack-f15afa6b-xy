# Application. Use an absolute DATABASE_PATH in systemd/production.
DATABASE_PATH=data/pulse109.db

# Local demo boundary: only active together with P109_AUTH_DISABLED=1.
# Never enable either flag on a public deployment.
# P109_DEMO_MODE=1

# Local loopback demo only. Never set this in production.
# P109_AUTH_DISABLED=1
# Production: first account becomes admin; later signups require this secret.
# P109_SIGNUP_INVITE=
P109_SECURE_COOKIES=1
# P109_CORS_ORIGINS=https://xy.govtech-kz.com

# mock | existing_classifier | shadow | laya | hybrid
# Synthetic-trained Laya is approved for shadow demonstration only.
P109_DECISION_PROVIDER=shadow
P109_LAYA_BASE_URL=http://127.0.0.1:8001
P109_LAYA_TIMEOUT=8
P109_LAYA_MODEL=multilingual
P109_LAYA_CHECKPOINT_ID=f56bcae3d1270eb4ca271569eb7e3c3ce4b997c7ae0bd6f510f8f79c42480062
P109_LAYA_SPAM_THRESHOLD=0.9
P109_HIGH_CONFIDENCE=0.85
P109_MEDIUM_CONFIDENCE=0.55
P109_ENABLE_VERIFICATION=1
P109_ENABLE_HYBRID=1
P109_LAYA_DEMO_FALLBACK=0
# P109_LAYA_API_KEY=

# Private fine-tuned multilingual E5. Unavailable service => lexical_fallback.
P109_SIMILARITY_URL=http://127.0.0.1:8004
P109_SIMILARITY_CHECKPOINT_ID=8df810a25f82e17aaa47ef07479c1be50f11efb4521b6b73c594b448acdc755e
P109_SIMILARITY_TIMEOUT=8
# Server only: P109_SIMILARITY_MODEL_PATH=/srv/pulse109/similarity/seed-29-best

# Private self-hosted Qwen. Uncomment URL and key together.
# Unavailable/invalid response => deterministic_fallback.
# P109_COPILOT_BASE_URL=http://127.0.0.1:8005
# P109_COPILOT_API_KEY=
# P109_COPILOT_MODEL=Qwen/Qwen3-4B-Instruct-2507
# P109_COPILOT_REVISION=cdbee75f17c01a7cc42f958dc650907174af0554
# P109_COPILOT_TIMEOUT=18

# Private RU/KK speech services. Text intake remains available if either is offline.
P109_STT_BASE_URL=http://127.0.0.1:8002
P109_STT_TIMEOUT=35
# P109_STT_API_KEY=
P109_TTS_BASE_URL=http://127.0.0.1:8003
P109_TTS_TIMEOUT=35
# P109_TTS_API_KEY=
P109_VOICE_REQUESTS_PER_MINUTE=30

# Private S3-compatible media storage. Omit both to store demo media in SQLite.
# P109_S3_ENDPOINT=https://object.example.kz
# P109_S3_BUCKET=pulse109-private
# P109_S3_REGION=us-east-1
# P109_S3_PREFIX=pulse109
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Analytics source is selected per request/UI, not by env:
# data_origin=synthetic_demo -> current deterministic 20-region demonstration
# data_origin=organizer      -> incomplete/stale 6-region organizer aggregates
