# mock | existing_classifier | shadow | laya | hybrid
P109_DECISION_PROVIDER=mock
P109_LAYA_BASE_URL=http://127.0.0.1:8000
P109_LAYA_TIMEOUT=8
P109_LAYA_MODEL=multilingual
# Public immutable model identifier; do not use a local filesystem path.
# P109_LAYA_CHECKPOINT_ID=pulse109-laya-<checkpoint-sha>
P109_HIGH_CONFIDENCE=0.85
P109_MEDIUM_CONFIDENCE=0.55
P109_ENABLE_VERIFICATION=1
P109_ENABLE_HYBRID=1
P109_LAYA_DEMO_FALLBACK=0

# Optional when a remote Laya server requires bearer authentication.
# P109_LAYA_API_KEY=
